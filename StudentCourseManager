	public static void bubbleSort() //sorts student information in ascending order based on student ID
	{

		if(ids == null)
		{
			System.out.println("No student information available.");
			return; //exits the method if no student data has been entered
		}



		for(int i = 0; i < studentsNum - 1; i++)
		{

			for(int j = 0; j < studentsNum - i - 1; j++)
			{	//compares neighbouring student IDs


				if(ids[j] > ids[j+1])
				{

					//swaps IDs to place them in the correct order
					int tempID = ids[j];
					ids[j] = ids[j+1];
					ids[j+1] = tempID;

					//swaps first name for correct order
					String tempFirst = firstNames[j];
					firstNames[j] = firstNames[j+1];
					firstNames[j+1] = tempFirst;


					//swaps last name for correct order
					String tempLast = lastNames[j];
					lastNames[j] = lastNames[j+1];
					lastNames[j+1] = tempLast;


					//swaps courses for correct order for each student
					String[] tempCourse = courses[j];
					courses[j] = courses[j+1];
					courses[j+1] = tempCourse;


					//swaps grades for each student for correct order
					double[] tempGrade = grades[j];
					grades[j] = grades[j+1];
					grades[j+1] = tempGrade;


					//swaps averages to keep correct average for student
					double tempAverage = averages[j];
					averages[j] = averages[j+1];
					averages[j+1] = tempAverage;


				}

			}

		}



		System.out.println("Students successfully sorted by ID."); //prints out the following if successful

	}
	
	public static String capitalize(String text) //capitalizes the first letter of a name, rest lowercase
	{

		if(text == null || text.isEmpty()) //handles empty or missing text safely
		{
			return text;
		}

		return text.substring(0, 1).toUpperCase() + text.substring(1).toLowerCase();
		//makes the first letter uppercase and the rest lowercase

	}

	public static void writeFile()
{

    if(ids == null)
    {
        System.out.println("No student information available.");
        return; //exits the method if no student data exists
    }



    try(FileWriter myWriter = new FileWriter("Students.txt"))
    {

        myWriter.write("========== STUDENT COURSE MANAGER ==========\n");
        myWriter.write("Semester " + semester + "\n\n"); //writes the semester chosen



        //writes formatted column headings for the student records
        myWriter.write(
            String.format(
                "%-10s %-20s %-15s %-15s %-15s %-15s\n",
                "ID",
                "Name",
                "Course 1",
                "Course 2",
                "Course 3",
                "Course 4"
            )
        );

        myWriter.write("--------------------------------------------------------------------------------\n");



        for(int i = 0; i < studentsNum; i++)
        {
            //loops through each student to write their information


            myWriter.write(
                String.format(
                    "%-10d %-20s %-15s %-15s %-15s %-15s\n",
                    ids[i],
                    capitalize(firstNames[i]) + " " + capitalize(lastNames[i]),
                    courses[i][0],
                    courses[i][1],
                    courses[i][2],
                    courses[i][3]
                )
            );
            //writes each student's info in table format



            myWriter.write(
                String.format(
                    "%-30s %-15s %-15s %-15s %-15s\n",
                    "Grades:",
                    String.format("%.1f%%", grades[i][0]),
                    String.format("%.1f%%", grades[i][1]),
                    String.format("%.1f%%", grades[i][2]),
                    String.format("%.1f%%", grades[i][3])
                )
            );
            //writes each student's grades in table 



            myWriter.write(
                String.format(
                    "%-10s %.2f%% (%s)\n",
                    "Average:",
                    averages[i],
                    getLetterGrade(averages[i])
                )
            );
            //writes the student's average and corresponding letter grade
            



            myWriter.write("--------------------------------------\n\n");

        }



   

        double classAverage = calculateClassAverage();



        myWriter.write(
            String.format(
            "\nClass Average: %.2f%% (%s)\n\n",
            classAverage,
            getLetterGrade(classAverage)
            )
        );
        //writes the final class average letter grade to the file
        




        //find highest and lowest grades 


        int highestIndex = findHighestIndex();

        int lowestIndex = findLowestIndex();


        String highestName =
            capitalize(firstNames[highestIndex]) + " " + capitalize(lastNames[highestIndex]);
        //stores the student's name with highest grade


        String lowestName =
            capitalize(firstNames[lowestIndex]) + " " + capitalize(lastNames[lowestIndex]);
        //stores the student's name with lowest grade



        
        
        myWriter.write(
            String.format(
                "Highest Average: %s - %.2f%% (%s)\n",
                highestName,
                averages[highestIndex],
                getLetterGrade(averages[highestIndex])
            )
        );
        
        //writes the student with the highest average and letter to file 




        myWriter.write(
            String.format(
            "Lowest Average: %s - %.2f%% (%s)\n",
            lowestName,
            averages[lowestIndex],
            getLetterGrade(averages[lowestIndex])
            )
        );
        
        //writes the student with the lowest average and their  letter grade to the file




        myWriter.flush();
        //ensures all remaining information is written before closing the file


        java.io.File savedFile = new java.io.File("Students.txt");
        //creates a file object to check the saved file information



        System.out.println("Successfully written to Students.txt");
        System.out.println("File location: " + savedFile.getAbsolutePath());
        System.out.println("File size: " + savedFile.length() + " bytes");
        //wrote this initially to see where the file went as I was not able to find it 



    }


    catch(IOException e)
    {

        System.out.println("Error writing file.");
        e.printStackTrace();
        //handles any errors that occur while writing to the file

    }

}
