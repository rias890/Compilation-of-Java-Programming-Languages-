			System.out.print("Enter semester (1 or 2): ");

			while(!input.hasNextInt()) //checks if input is a letter 
			{
				System.out.println("Invalid input. Please enter 1 or 2.");
				input.next();
				System.out.print("Enter semester (1 or 2): ");
			}

			semester = input.nextInt();
			input.nextLine();
		}



		ids = new int[studentsNum]; //creates an array for ids

		firstNames = new String[studentsNum]; //creates an array for first names

		lastNames = new String[studentsNum]; //creates an array for last names

		courses = new String[studentsNum][4]; //creates an array for courses

		grades = new double[studentsNum][4]; //creates an array for grades

		averages = new double[studentsNum];//creates an array for averages



		for(int i = 0; i < studentsNum; i++)
			//goes through the number of students and asks the following
		{

			System.out.println("STUDENT " + (i+1));



			boolean duplicate;

        do
        {
            duplicate = false;
        
            System.out.print("Enter ID number: "); //asks for ID number 
        
            while(!input.hasNextInt())
            {
                System.out.println("Invalid input. Please enter a number.");
                input.next();
                System.out.print("Enter ID number: "); //checks if the ID is a number 
            }
        
            ids[i] = input.nextInt();
            input.nextLine();
        
            if(ids[i] < 0)
            {
                System.out.println("ID cannot be negative."); //checks if ID is negative 
                duplicate = true;
            }
        
            //checks for duplicate IDs
            for(int k = 0; k < i; k++)
            {
                if(ids[k] == ids[i])
                {
                    System.out.println("ID already exists. Please enter a unique ID.");
                    duplicate = true;
                }
            }
        
        } while(duplicate);



			firstNames[i] = getValidText("Enter first name: "); //aks for first names and appends to array



			lastNames[i] = getValidText("Enter last name: "); //asks for last names and appends to array



			double total = 0; //the total variable for averages



			for(int j = 0; j < 4; j++)
			{

				courses[i][j] = getValidText("Enter course " + (j+1) + ": "); //stores the course name in the course array



