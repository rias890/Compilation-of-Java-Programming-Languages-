	public static String getValidText(String prompt) //ensures only letters and spaces are entered
	{

		String value; //stores the entered text


		while(true)
		{

			System.out.print(prompt);

			value = input.nextLine();


			if(value.matches("[a-zA-Z ]+")) //checks that the input contains only letters and spaces
			{
				return value;
			}


			System.out.println("Invalid input. Please enter letters only.");

		}

	}


	public static double getGrade()
	{

		double grade; //creates grade variable


		while(true)
		{

			System.out.print("Enter grade (0-100): "); //asks the user to enter a grade between 0 and 100


			if(input.hasNextDouble()) //checks to see if it is a number
			{

				grade = input.nextDouble();
				input.nextLine();


				if(grade >= 0 && grade <= 100)
				{
					return grade; //if the grade is a number checks to see if between 1 and 100
				}

			}

			else
			{
				input.next();
			}


			System.out.println("Invalid grade. Please enter a value between 0 and 100."); //if it does not meet these requirements writes that it is an invalid input

		}

	}
	
	public static String getLetterGrade(double grade) //this method displays letter grades 
    {
        if(grade >= 95)
        {
            return "A+";
        }
        else if(grade >= 90)
        {
            return "A";
        }
        else if(grade >= 85)
        {
            return "A-";
        }
        else if(grade >= 80)
        {
            return "B+";
        }
        else if(grade >= 75)
        {
            return "B";
        }
        else if(grade >= 70)
        {
            return "B-";
        }
        else if(grade >= 65)
        {
            return "C+";
        }
        else if(grade >= 60)
        {
            return "C";
        }
        else if(grade >= 55)
        {
            return "C-";
        }
        else if(grade >= 50)
        {
            return "D";
        }
        else
        {
            return "F";
        }
    }



