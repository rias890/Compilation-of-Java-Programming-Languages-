    public static void displayClassAverage()
    {
    
        if(averages == null) //checks if no student information has been entered
        {
            System.out.println("No student information available.");
            return; //exits the method if there is no data to display
        }
    
    
        int passed = 0; //counts the number of students who passed

        int failed = 0; //counts the number of students who failed



        for(int i = 0; i < studentsNum; i++)
        {
            if(averages[i] >= 50)
            {
                passed++; //adds to the number of students who passed
            }
            else
            {
                failed++; //adds to the number of students who failed
            }
        }



        double classAverage = calculateClassAverage();
        //calculates the overall class average 


        double passRate = (double) passed / studentsNum * 100;
        //calculates pass rate
    
    
    
        System.out.printf(
        "\nClass Average: %.2f%% (%s)\n",
        classAverage,
        getLetterGrade(classAverage)
        );
        //displays the class average and corresponding letter grade 
    
        System.out.println(
            "Students Passed: " + passed
        ); //displays the total number of students who passed
    
    
        System.out.println(
            "Students Failed: " + failed
        ); //displays the total number of students who failed
    
    
        System.out.printf(
            "Pass Rate: %.1f%%\n",
            passRate
        ); //displays the class pass rate rounded to one decimal place
    
    }


    public static double calculateClassAverage() 
    {
        double total = 0; //stores the total of all student averages

        for(int i = 0; i < studentsNum; i++)
        {
            total += averages[i]; //adds each student's average to the total
        }

        return total / studentsNum; //returns the overall class average
    }


    public static int findHighestIndex() //checks the highest grade 
    {
        int highestIndex = 0; //assumes the first student has the highest average

        for(int i = 1; i < studentsNum; i++)
        {
            if(averages[i] > averages[highestIndex])
            {
                highestIndex = i; //updates the index whenever a higher average is found
            }
        }

        return highestIndex;
    }


    public static int findLowestIndex() //checks the lowest average
    {
        int lowestIndex = 0; //assumes the first student has the lowest average

        for(int i = 1; i < studentsNum; i++)
        {
            if(averages[i] < averages[lowestIndex])
            {
                lowestIndex = i; //updates the index whenever a lower average is found
            }
        }

        return lowestIndex;
    }



