public class ShapeMethods
    {

        public static double circleArea(double radius)
        {
            return Math.PI * radius * radius; //for circle area calculate the area using math 
        }
    
        public static double circleCircumference(double radius)
        {
            return 2 * Math.PI * radius; //does the same for circle circumference 
        }
    
        
        public static double rectangleArea(double length, double width)
        {
            return length * width; //calculates rectangle area 
        }
    
        public static double rectanglePerimeter(double length, double width)
        {
           return 2 * (length + width); //calculates rectangle perimeter 
        }
    
       
        public static double squareArea(double side)
        {
            return side * side; //calculates square area 
        }
    
        public static double squarePerimeter(double side)
        {
            return 4 * side; //calculates square perimeter 
        }
    
        
        public static double equilateralArea(double side)
        {
            return (Math.sqrt(3) / 4) * side * side; //calculates equilateral triangle area 
        }
    
        public static double equilateralPerimeter(double side)
        {
            return 3 * side; //calculates equilateral triangle perimeter 
        }
    
        
        public static double isoscelesArea(double base, double height)
        {
           return (base * height) / 2; //calculates isosceles triangle area 
        }
    
        public static double isoscelesPerimeter(double equalSide, double base)
        {
            return (2 * equalSide) + base; //calculates isosceles triangle perimeter 
        }
    
        
        public static double rightTriangleArea(double base, double height)
        {
           return (base * height) / 2; //calculates right triangle area 
        }
    
        public static double rightTrianglePerimeter(double base, double height)
        {
            double hypotenuse = Math.sqrt((base * base) + (height * height));
            return base + height + hypotenuse; //calulates right triangle perimeter 
        }
    
        
        public static double rectangularPrismSurfaceArea(double length, double width, double height)
        {
            return 2 * ((length * width) + (length * height) + (width * height)); //calculates rectangular prism SA
        }
    
        public static double rectangularPrismVolume(double length, double width, double height)
        {
            return length * width * height; // calculates volume of rectangular prism 
        }
    
        
        public static double triangularPrismSurfaceArea(double base, double height,
                                                        double side1, double side2,
                                                        double prismLength)
        {
            double triangleArea = (base * height) / 2;
            double perimeter = base + side1 + side2;
    
            return (2 * triangleArea) + (perimeter * prismLength); //calculates triangular prism SA
        }
    
        public static double triangularPrismVolume(double base, double height,
                                                   double prismLength)
        {
            return ((base * height) / 2) * prismLength; //calculates triangular prism volume 
        }
    
        
        public static double cubeSurfaceArea(double side)
        {
            return 6 * side * side; // calculates cube surface area
        }
        
        public static double cubeVolume(double side)
        {
            return side * side * side; // calculates cube volume
        }

} // closes ShapeMethods
    











