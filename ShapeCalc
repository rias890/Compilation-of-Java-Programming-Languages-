		System.out.print("Enter the output unit (cm, m, in): "); //asks for desired output unit
		String outputUnit = getValidUnit(input);

		// convert radius to cm
		radius = convertToCm(radius, inputUnit);

		// calculate area and circumference in ShapeMethods
		double area = ShapeMethods.circleArea(radius);
		double circumference = ShapeMethods.circleCircumference(radius);

		// convert results to desired output unit
		area = convertArea(area, outputUnit);
		circumference = convertLength(circumference, outputUnit);

		System.out.printf("Area: %.6f %s²\n", area, outputUnit); //prints out area
		System.out.printf("Circumference: %.6f %s\n", circumference, outputUnit); //prints out circumference

		addHistory(String.format("Circle -> Area: %.6f %s², Circumference: %.6f %s",
		                          area, outputUnit, circumference, outputUnit)); //saves this result to history
	}

