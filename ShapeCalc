	public static String getValidUnit(Scanner input)
	{
		String unit; //stores the measurement unit entered by the user

		do
		{
			unit = input.next(); //gets the user's unit input

			if(!unit.equalsIgnoreCase("cm") && //checks if the unit entered is not cm, m, or in
			        !unit.equalsIgnoreCase("m") &&
			        !unit.equalsIgnoreCase("in"))
			{
				System.out.print("Invalid unit. Enter cm, m, or in: "); //asks the user to enter a valid unit
			}

		} while(!unit.equalsIgnoreCase("cm") &&
		        !unit.equalsIgnoreCase("m") &&
		        !unit.equalsIgnoreCase("in")); //repeats until a valid unit is entered


		return unit; //returns the valid measurement unit
	}

	public static double convertToCm(double value, String unit) //converts value to cm first
	{
		if(unit.equalsIgnoreCase("in"))
		{
			return value * 2.54; //if the user puts in inches it converts the unit to cm
		}
		else if(unit.equalsIgnoreCase("m"))
		{
			return value * 100; //if the user puts in meters it converts the unit to cm
		}
		else
		{
			return value; // already cm
		}
	}


	public static double convertLength(double value, String unit)
	{
		if(unit.equalsIgnoreCase("in"))
		{
			return value / 2.54; //if the user wants inches it converts cm to in
		}
		else if(unit.equalsIgnoreCase("m")) //if the user wants m it converts cm to m
		{
			return value / 100;
		}
		else
		{
			return value;
		}

	}

	public static double convertArea(double value, String unit)
	{
		if(unit.equalsIgnoreCase("in"))
		{
			return value / (2.54 * 2.54); //for area it converts square inches to cm
		}
		else if(unit.equalsIgnoreCase("m"))
		{
			return value / (100 * 100); //it converts square meters to cm
		}
		else
		{
			return value;
		}
	}

	public static double convertVolume(double value, String unit)
	{
		if(unit.equalsIgnoreCase("in"))
		{
			return value / (2.54 * 2.54 * 2.54); //converts cubic inches to cm
		}
		else if(unit.equalsIgnoreCase("m"))
		{
			return value / (100 * 100 * 100); //converts cubic meters to cm
		}
		else
		{
			return value;
		}
	}

	public static double getPositiveDouble(Scanner input, String prompt)
	{
		double value;

		System.out.print(prompt);

		while(!input.hasNextDouble()) //checks if input is a number
		{
			System.out.print("Invalid input. Please enter a number: ");
			input.next();
		}

		value = input.nextDouble();

		while(value <= 0) //checks if the measurement is positive
		{
			System.out.print("Invalid measurement. Please enter a positive number: ");

			while(!input.hasNextDouble()) //checks that the retry is actually a number too, so a letter here can't crash the program
			{
				System.out.print("Invalid input. Please enter a number: ");
				input.next();
			}

			value = input.nextDouble();
		}

		return value;
	}

