	        //checks if there are no previous calculations
	    }


	    else
	    {
	        for(int i = 0; i < historyCount; i++)
	        {
	            System.out.println("\nCalculation " + (i + 1));
	            System.out.println(history[i]);
	            //loops through the history array and displays calculations
